[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "phylotypr"]
	path = phylotypr
	url = https://github.com/mothur/phylotypr
[submodule "rchime"]
	path = rchime
	url = https://github.com/mothur/rchime
[submodule "strollur"]
	path = strollur
	url = https://github.com/mothur/strollur
